# Clé API Brevo (Paramètres > SMTP & API > Clés API)
BREVO_API_KEY=xkeysib-xxxxxxxx
# Liste Brevo recevant les participations au jeu-concours
BREVO_CONTEST_LIST_ID=12
# Liste Brevo de la newsletter InRealArt (opt-in coché dans le formulaire)
BREVO_NEWSLETTER_LIST_ID=3

# URL publique du site (metadata, Open Graph)
NEXT_PUBLIC_SITE_URL=https://salon.inrealart.com
